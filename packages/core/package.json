{
  "name": "@rackbops/docket-core",
  "version": "0.5.0",
  "description": "Tracker core: people, tasks, occurrences, schedules, the two lanes, the task-type contract and the ports. No platform code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rackbops/docket.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
