{
  "name": "@rackbops/docket-types",
  "version": "0.6.0",
  "description": "The tracker's task types: reminder, renewal, price, research, scout, wantlist, wantjudge. Built on @rackbops/docket-core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rackbops/docket.git",
    "directory": "packages/types"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rackbops/docket-core": "workspace:^"
  }
}
