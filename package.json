{
  "name": "docket",
  "private": true,
  "version": "0.0.0",
  "description": "Tracker core library: people, tasks, schedules, task types and ports. Workspace root; the published packages are under packages/.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rackbops/docket.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
